{
  "name": "vue-query-request-utils",
  "version": "2.0.0",
  "description": "Small HTTP toolkit for Vue 3 and TanStack Vue Query",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:exports": "node scripts/verify-exports.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:exports",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@tanstack/vue-query": "^5.107.1",
    "axios": "^1.21.1",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@tanstack/vue-query": "^5.107.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "2.4.11",
    "axios": "^1.21.1",
    "jsdom": "^31.0.1",
    "msw": "^3.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  },
  "keywords": [
    "vue",
    "vue-query",
    "tanstack-query",
    "axios",
    "http",
    "api-client",
    "vue-composable",
    "vue-plugin",
    "get",
    "post",
    "put",
    "patch",
    "delete"
  ],
  "author": "cristopherpp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cristopherpp/vue-query-request-utils.git"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./axios": {
      "types": "./dist/axios.d.ts",
      "import": "./dist/axios.js"
    }
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    }
  }
}
